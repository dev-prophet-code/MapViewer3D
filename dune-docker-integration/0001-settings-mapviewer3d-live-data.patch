+
+vi.mock("../../api/client", () => ({ api: vi.fn(), post: vi.fn() }));
+
+import { api, post } from "../../api/client";
+
+const mockedApi = vi.mocked(api);
+const mockedPost = vi.mocked(post);
+const PIN = `sha256/${"B".repeat(43)}`;
+const CODE = `mvlive1:${"C".repeat(120)}`;
+
+function running() {
+  return { installed: true, running: true, state: "running", health: "healthy", fingerprint: PIN, protocolVersion: 1 };
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mockedApi.mockResolvedValue(running());
+});
+
+test("shows the install commands when the stack is missing and offers no pairing", async () => {
+  mockedApi.mockResolvedValue({ installed: false, running: false, health: "", fingerprint: "", protocolVersion: 1 });
+  render(<MapViewerLiveSection confirmAction={vi.fn()} />);
+  expect(await screen.findByText("Not Installed")).toBeVisible();
+  expect(screen.getByText(/docker compose -f docker-compose.mapviewer-live.yml up -d --build/)).toBeVisible();
+  expect(screen.queryByRole("button", { name: /create pairing code/i })).toBeNull();
+});
+
+test("creates a pairing code for the entered address and shows it once", async () => {
+  mockedPost.mockResolvedValue({ code: CODE, address: "dune.example.org", fingerprint: PIN });
+  const confirmAction = vi.fn().mockResolvedValue(true);
+  render(<MapViewerLiveSection confirmAction={confirmAction} />);
+  expect(await screen.findByText("Running")).toBeVisible();
+  expect(screen.getByText(PIN)).toBeVisible();
+  fireEvent.change(screen.getByLabelText("Public Address"), { target: { value: "dune.example.org" } });
+  fireEvent.click(screen.getByRole("button", { name: /create pairing code/i }));
+  const field = await screen.findByLabelText(/MapViewer3D pairing code/i);
+  expect(field).toHaveValue(CODE);
+  expect(mockedPost).toHaveBeenCalledWith("/api/settings/mapviewer-live/pairing-code", { publicAddress: "dune.example.org" });
+  // jsdom serves the page over http://localhost: no plain-HTTP warning there
+  expect(confirmAction).not.toHaveBeenCalled();
+  fireEvent.click(screen.getByRole("button", { name: /i've saved it/i }));
+  await waitFor(() => expect(screen.queryByLabelText(/MapViewer3D pairing code/i)).toBeNull());
+  expect(screen.queryByDisplayValue(CODE)).toBeNull();
+});
+
+test("revoking all pairings asks first and does nothing when cancelled", async () => {
+  const confirmAction = vi.fn().mockResolvedValue(false);
+  render(<MapViewerLiveSection confirmAction={confirmAction} />);
+  fireEvent.click(await screen.findByRole("button", { name: /revoke all pairings/i }));
+  await waitFor(() => expect(confirmAction).toHaveBeenCalled());
+  expect(confirmAction.mock.calls[0][1]).toMatchObject({ title: "Revoke All Pairings", danger: true });
+  expect(mockedPost).not.toHaveBeenCalled();
+});
+
+test("revoking all pairings calls the console after confirmation", async () => {
+  mockedPost.mockResolvedValue({ ok: true });
+  const confirmAction = vi.fn().mockResolvedValue(true);
+  render(<MapViewerLiveSection confirmAction={confirmAction} />);
+  fireEvent.click(await screen.findByRole("button", { name: /revoke all pairings/i }));
+  await waitFor(() => expect(mockedPost).toHaveBeenCalledWith("/api/settings/mapviewer-live/revoke", {}));
+  expect(await screen.findByText(/All pairings revoked/i)).toBeVisible();
+});
+
+test("a stopped gate explains how to start it and hides the pairing controls", async () => {
+  mockedApi.mockResolvedValue({ ...running(), running: false, state: "exited", health: "", fingerprint: "" });
+  render(<MapViewerLiveSection confirmAction={vi.fn()} />);
+  expect(await screen.findByText("Stopped")).toBeVisible();
+  expect(screen.queryByRole("button", { name: /create pairing code/i })).toBeNull();
+});
