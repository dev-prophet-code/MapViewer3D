+++ b/console/web/src/api/mapViewerLive.ts
@@ -0,0 +1,25 @@
+import { api, post } from "./client";
+
+// MapViewer3D Live Data (console/api/src/services/mapViewerLive.js). None of
+// these answers is cached by the browser; the pairing code exists only in the
+// response that created it.
+export type MapViewerLiveStatus = {
+  installed: boolean;
+  running: boolean;
+  state?: string;
+  health: string;
+  fingerprint: string;
+  protocolVersion: number;
+};
+
+export type MapViewerLivePairing = {
+  code: string;
+  address: string;
+  fingerprint: string;
+};
+
+export const mapViewerLiveApi = {
+  status: () => api<MapViewerLiveStatus>("/api/settings/mapviewer-live", { cache: "no-store" }),
+  createPairingCode: (publicAddress: string) => post<MapViewerLivePairing>("/api/settings/mapviewer-live/pairing-code", { publicAddress }),
+  revokeAll: () => post<{ ok: boolean }>("/api/settings/mapviewer-live/revoke", {})
+};
