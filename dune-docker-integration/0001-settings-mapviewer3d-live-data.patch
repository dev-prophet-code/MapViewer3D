@@ -0,0 +1,193 @@
+import { useEffect, useRef, useState } from "react";
+import { AlertTriangle, Copy, KeyRound, ShieldOff } from "lucide-react";
+import { mapViewerLiveApi, type MapViewerLivePairing, type MapViewerLiveStatus } from "../../api/mapViewerLive";
+import { StatusPill } from "../../components/common/DisplayPrimitives";
+import { InlineActionResult, type InlineActionResultState } from "../../components/common/InlineActionResult";
+import { copyText } from "../../lib/clipboard";
+
+type ConfirmAction = (
+  message: string,
+  options?: { title?: string; confirmLabel?: string; cancelLabel?: string; danger?: boolean }
+) => Promise<boolean>;
+
+const INSTALL_COMMANDS = [
+  "git clone --branch ddp --depth 1 https://github.com/dev-prophet-code/MapViewer3D.git mapviewer-live",
+  "cd mapviewer-live && cp .env.example .env",
+  "docker compose -f docker-compose.mapviewer-live.yml up -d --build"
+].join("\n");
+
+// A pairing code shown over plain HTTP crosses the network unencrypted. The
+// console itself is often reached that way on a LAN, so this warns and asks
+// instead of refusing.
+function insecureTransport() {
+  const { protocol, hostname } = window.location;
+  return protocol !== "https:" && !["localhost", "127.0.0.1", "[::1]", "::1"].includes(hostname);
+}
+
+function statusLabel(status: MapViewerLiveStatus) {
+  if (!status.installed) return "Not Installed";
+  if (!status.running) return "Stopped";
+  if (status.health === "healthy") return "Running";
+  if (status.health === "starting") return "Starting";
+  if (status.health === "unhealthy") return "Unhealthy";
+  return "Running";
+}
+
+export function MapViewerLiveSection({ confirmAction }: { confirmAction: ConfirmAction }) {
+  const [status, setStatus] = useState<MapViewerLiveStatus | null>(null);
+  const [address, setAddress] = useState(() => window.location.hostname);
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState<InlineActionResultState | null>(null);
+  const [revealed, setRevealed] = useState<MapViewerLivePairing | null>(null);
+  const [copied, setCopied] = useState(false);
+  const focusedCode = useRef("");
+
+  async function refresh() {
+    try {
+      setStatus(await mapViewerLiveApi.status());
+    } catch (error) {
+      setStatus({ installed: false, running: false, health: "", fingerprint: "", protocolVersion: 1 });
+      setResult({ key: "status", tone: "danger", text: error instanceof Error ? error.message : String(error) });
+    }
+  }
+
+  useEffect(() => { void refresh(); }, []);
+
+  useEffect(() => {
+    if (!result || result.pending) return undefined;
+    const id = window.setTimeout(() => setResult(null), 8000);
+    return () => window.clearTimeout(id);
+  }, [result]);
+
+  async function createCode() {
+    if (insecureTransport()) {
+      const proceed = await confirmAction(
+        "This console is opened over plain HTTP, so the pairing code would cross the network unencrypted. Anyone who reads it can view live positions. Continue only on a trusted network or through an SSH tunnel.",
+        { title: "Unencrypted Connection", confirmLabel: "Show Code Anyway", danger: true }
+      );
+      if (!proceed) return;
+    }
+    setBusy(true);
+    setResult({ key: "pair", tone: "neutral", text: "Creating pairing code...", pending: true });
+    try {
+      const pairing = await mapViewerLiveApi.createPairingCode(address);
+      setRevealed(pairing);
+      setCopied(false);
+      setResult(null);
+    } catch (error) {
+      setResult({ key: "pair", tone: "danger", text: error instanceof Error ? error.message : String(error) });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function revokeAll() {
+    const confirmed = await confirmAction(
+      "Revoke every MapViewer3D pairing? All paired viewers lose live data immediately and need a new pairing code. mvgate restarts once.",
+      { title: "Revoke All Pairings", confirmLabel: "Revoke All", danger: true }
+    );
+    if (!confirmed) return;
+    setBusy(true);
+    setRevealed(null);
+    setResult({ key: "pair", tone: "neutral", text: "Revoking all pairings...", pending: true });
+    try {
+      await mapViewerLiveApi.revokeAll();
+      setResult({ key: "pair", tone: "success", text: "All pairings revoked. Create a new pairing code for each viewer." });
+    } catch (error) {
+      setResult({ key: "pair", tone: "danger", text: error instanceof Error ? error.message : String(error) });
+    } finally {
+      setBusy(false);
+      void refresh();
+    }
+  }
+
+  async function copyCode() {
+    if (!revealed) return;
+    try {
+      await copyText(revealed.code);
+      setCopied(true);
+    } catch {
+      setCopied(false);
+      setResult({ key: "reveal", tone: "danger", text: "Could not copy automatically. Select the code and copy it manually." });
+    }
+  }
+
+  if (status === null) return <p className="muted">Loading MapViewer3D Live Data...</p>;
+
+  return <div className="mapviewer-live-section">
+    <p className="muted">
+      Streams live sandworms, enemies, civilians, vehicles and sandstorms from the game servers to a MapViewer3D running on
+      an administrator&apos;s PC. The connection is always encrypted (TLS 1.3) and pinned to this server&apos;s key; the
+      secret never travels over the network. A viewer only receives data after you create a pairing code for it here.
+    </p>
+
+    <div className="action-row">
+      <span className="switch-label">Status:</span>
+      <StatusPill value={statusLabel(status)} />
+      {status.fingerprint && <span className="muted">Key Fingerprint: <code>{status.fingerprint}</code></span>}
+      <InlineActionResult result={result} resultKey="status" />
+    </div>
+
+    {!status.installed && <div className="attention-text">
+      <p>MapViewer3D Live Data is not installed on this host. Run these commands in the host shell, then reload this page:</p>
+      <pre className="mapviewer-live-install">{INSTALL_COMMANDS}</pre>
+    </div>}
+
+    {status.installed && !status.running && <p className="attention-text">
+      The mvgate container is stopped. Start it with <code>docker compose -f docker-compose.mapviewer-live.yml up -d</code>.
+    </p>}
+
+    {revealed && <div className="api-key-reveal" role="alert" aria-live="assertive">
+      <div className="api-key-reveal-warning">
+        <AlertTriangle size={16} aria-hidden="true" />
+        <span>Copy this pairing code now. It will not be shown again. Treat it like a password.</span>
+      </div>
+      <div className="api-key-reveal-row">
+        <input
+          readOnly
+          ref={(node) => { if (node && revealed.code !== focusedCode.current) { focusedCode.current = revealed.code; node.focus(); node.select(); } }}
+          value={revealed.code}
+          aria-label="MapViewer3D pairing code. Copy it now, it will not be shown again."
+          onFocus={(event) => event.target.select()}
+        />
+        <button onClick={() => { void copyCode(); }}><Copy size={16} aria-hidden="true" /> {copied ? "Copied" : "Copy"}</button>
+      </div>
+      <p className="muted">
+        For {revealed.address} · key {revealed.fingerprint || "unknown"}. In MapViewer3D (Beta.16 or newer) save it to a file and start
+        with <code>-agent-pair &lt;file&gt;</code>, or add it as <code>agentPairing</code> to the config file.
+      </p>
+      <div className="action-row">
+        <button onClick={() => setRevealed(null)}>I&apos;ve Saved It</button>
+        <InlineActionResult result={result} resultKey="reveal" />
+      </div>
+    </div>}
+
+    {status.running && <>
+      <div className="settings-password-grid">
+        <label>
+          <span className="field-label-row"><span>Public Address</span></span>
+          <input
+            value={address}
+            disabled={busy}
+            maxLength={260}
+            placeholder="dune.example.org or 203.0.113.7"
+            onChange={(event) => setAddress(event.target.value)}
+            aria-describedby="mapviewer-live-address-help"
+          />
+        </label>
+      </div>
+      <p className="muted" id="mapviewer-live-address-help">
+        The host name or IP address viewers use to reach this server. The gate port (8797) is added automatically; use host:port if you forward a different one.
+      </p>
+      <div className="action-row">
+        <button disabled={busy || !address.trim()} onClick={() => { void createCode(); }}>
+          <KeyRound size={16} aria-hidden="true" /> {busy ? "Working..." : "Create Pairing Code"}
+        </button>
+        <button className="danger" disabled={busy} onClick={() => { void revokeAll(); }}>
+          <ShieldOff size={16} aria-hidden="true" /> Revoke All Pairings
+        </button>
+        <InlineActionResult result={result} resultKey="pair" />
+      </div>
+    </>}
+  </div>;
+}
