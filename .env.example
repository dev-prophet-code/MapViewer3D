# Copy to .env and fill in.  Kopieren nach .env und ausfüllen.

# REQUIRED. Long random token; create one with:  openssl rand -hex 24
# PFLICHT. Langes Zufalls-Token, z. B. mit:       openssl rand -hex 24
MV_GATE_TOKEN=

# MapViewer3D release the agent is built from (tag on GitHub).
MV_REF=beta.15

# Also read players (real-time positions of online players). Off = privacy.
# Spieler mitlesen (Echtzeit-Positionen der Online-Spieler). Aus = Datenschutz.
MV_AGENT_PLAYERS=false

# Optional: only these IPs/networks may connect (comma separated).
# Optional: nur diese IPs/Netze dürfen verbinden (mit Komma getrennt).
# MV_GATE_ALLOW=203.0.113.7,198.51.100.0/24

# Port and interface of the gate. 127.0.0.1 = only via SSH tunnel / reverse proxy.
# MV_GATE_PORT=8797
# MV_GATE_BIND=0.0.0.0

# TLS (recommended when the port is reachable from the internet). Put the files
# into ./certs (or MV_GATE_CERT_DIR) and name them here as /certs/<file>.
# MV_GATE_TLS_CERT=/certs/fullchain.pem
# MV_GATE_TLS_KEY=/certs/privkey.pem

# Only if the agent log shows "permission denied" for /proc/<pid>/mem.
# MV_AGENT_APPARMOR=unconfined
