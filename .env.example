# Copy to .env.  Kopieren nach .env.

# MapViewer3D release the agent is built from, and the commit that tag must be.
MV_REF=beta.15
MV_COMMIT=7e1a73044023da89d42c9ea3ab3dba133904e8c1

# Also read players. They reach a client only if its API key has
# "Realtime Data" AND "Players: Read". Off = players are not even read.
# Spieler mitlesen. Sie erreichen einen Client nur, wenn sein API-Key
# "Realtime Data" UND "Players: Read" hat. Aus = Spieler werden gar nicht gelesen.
MV_AGENT_PLAYERS=false

# Sampling rate of moving objects, CPU limit, loopback port.
# MV_AGENT_HZ=10
# MV_AGENT_CPUS=1.0
# MV_AGENT_PORT=8796

# --- Encrypted front door (optional; start with --profile tls) -----------------
# --- Verschlüsselter Eingang (optional; Start mit --profile tls) ---------------
# Port and interface on the host, and where the Console listens.
# MV_TLS_PORT=8797
# MV_TLS_BIND=0.0.0.0
# MV_TLS_UPSTREAM=http://127.0.0.1:8088
# Host names / IPs written into the certificate (only needed for browsers; the
# viewer pins the key). Changing them keeps the key and its fingerprint.
# MV_TLS_NAMES=dune.example.org,203.0.113.7
# Only these IPs/networks may connect (comma separated).
# MV_TLS_ALLOW=203.0.113.7,198.51.100.0/24
# true = ALSO forward the Console web UI and login (default: API door only).
# MV_TLS_FULL=false

# AppArmor profile of the agent. Dune Docker runs the game containers
# "unconfined", which only an unconfined agent may read (default).
# AppArmor-Profil des Agenten. Dune Docker startet die Spiel-Container
# "unconfined"; nur ein ebenso "unconfined" Agent darf sie lesen (Standard).
# MV_AGENT_APPARMOR=unconfined

# --- Share gateway (optional; start with --profile share) ----------------------
# --- Share-Gateway (optional; Start mit --profile share) -----------------------
# Where it listens (loopback by default: an HTTPS reverse proxy forwards /s/ and
# /share-admin/ to it) and where the Console listens.
# MV_SHARE_ADDR=127.0.0.1:8798
# MV_SHARE_UPSTREAM=http://127.0.0.1:8088
# Origin(s) of the Console page that runs the MapViewer3D addon (it creates the
# links), e.g. https://console.example.org . Empty = the admin API refuses browsers.
# MV_SHARE_ADMIN_ORIGINS=
# true only if a reverse proxy in front SETS X-Forwarded-For (else visitors could fake it).
# MV_SHARE_TRUST_PROXY=false
# Own certificate instead of a reverse proxy (paths inside the container, /data/...).
# MV_SHARE_CERT=
# MV_SHARE_CERT_KEY=
# Directory with the viewer files (addon web/), see share/fetch-web.sh
# MV_SHARE_WEB=./share-web
