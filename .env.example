# Copy to .env.  Kopieren nach .env.

# MapViewer3D release the agent is built from, and the commit that tag must be.
MV_REF=beta.15
MV_COMMIT=7e1a73044023da89d42c9ea3ab3dba133904e8c1

# Also read players (real-time positions of online players). Off = privacy.
# Spieler mitlesen (Echtzeit-Positionen der Online-Spieler). Aus = Datenschutz.
MV_AGENT_PLAYERS=false

# Optional: only these IPs/networks may connect (comma separated).
# Optional: nur diese IPs/Netze dürfen verbinden (mit Komma getrennt).
# MV_GATE_ALLOW=203.0.113.7,198.51.100.0/24

# Port and interface of the gate on the host.
# MV_GATE_PORT=8797
# MV_GATE_BIND=0.0.0.0

# Leave empty: mvgate creates a strong token itself (in its volume).
# Leer lassen: mvgate erzeugt selbst ein starkes Token (im Volume).
# MV_GATE_TOKEN=

# Only if the agent log shows "permission denied" for /proc/<pid>/mem.
# MV_AGENT_APPARMOR=unconfined
