# Copy to .env.  Kopieren nach .env.

# MapViewer3D release the agent is built from, and the commit that tag must be.
MV_REF=beta.15
MV_COMMIT=7e1a73044023da89d42c9ea3ab3dba133904e8c1

# Also read players. They reach a client only if its API key has
# "Realtime Data" AND "Players: Read". Off = players are not even read.
# Spieler mitlesen. Sie erreichen einen Client nur, wenn sein API-Key
# "Realtime Data" UND "Players: Read" hat. Aus = Spieler werden gar nicht gelesen.
MV_AGENT_PLAYERS=false

# Sampling rate of moving objects, CPU limit, loopback port.
# MV_AGENT_HZ=10
# MV_AGENT_CPUS=1.0
# MV_AGENT_PORT=8796

# AppArmor profile of the agent. Dune Docker runs the game containers
# "unconfined", which only an unconfined agent may read (default).
# AppArmor-Profil des Agenten. Dune Docker startet die Spiel-Container
# "unconfined"; nur ein ebenso "unconfined" Agent darf sie lesen (Standard).
# MV_AGENT_APPARMOR=unconfined
