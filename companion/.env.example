# Adresse der Dune-Docker-Console (Pflicht). Bevorzugt https (verschlüsselter Zugang, Port 8797).
CONSOLE_URL=https://console.example.org:8797
# Nur wenn die Console unverschlüsselt über das Netz erreicht wird (Token läuft dann im Klartext!):
# CONSOLE_ALLOW_HTTP=1
# Fingerabdruck für selbstsignierte Zertifikate (Console: Settings -> Encrypted API Access):
# CONSOLE_PIN=sha256/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kartendaten: festes, unveränderliches Tag des Branches "cdn"
CDN_BASE=https://raw.githubusercontent.com/dev-prophet-code/MapViewer3D/data-v2/
# SHA-256 der catalog.json festhalten (beim ersten Start steht der Wert im Log):
# CDN_CATALOG_SHA256=

# Erlaubte Host-Namen (Pflicht hinter einem Reverse-Proxy), kommagetrennt:
# ALLOWED_HOSTS=mapviewer.example.org
# Nur setzen, wenn ein vertrauenswürdiger Proxy davor sitzt (liest X-Forwarded-For/-Proto):
# TRUST_PROXY=1
# SESSION_TTL_MIN=480
