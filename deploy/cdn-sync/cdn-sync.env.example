# /etc/mapviewer-cdn.env – Einstellungen für cdn-sync.sh / settings for cdn-sync.sh
# Ordner mit cdnsync, extract und dem Deploy-Key (deploy_key) / folder with cdnsync, extract and the deploy key
BIN=/opt/mapviewer-cdn
# Arbeitsordner / work folder
WORK=/var/lib/mapviewer-cdn
# data/ des laufenden Viewers auf diesem Server (leer = weglassen) / data/ of the viewer running on this server
DATA_LIVE=/www/wwwroot/dune3d/data
# Repository (SSH-Adresse, damit der Deploy-Key greift) / repository (SSH URL for the deploy key)
CLONE_URL=git@github.com:dev-prophet-code/MapViewer3D.git
# Zum Ausprobieren ohne Push: DRY_RUN=1 / to try without pushing: DRY_RUN=1
#DRY_RUN=1
# Nur die Viewer-Daten packen, nie aus den Spieldateien extrahieren / never extract from the game files
#SKIP_EXTRACT=1
